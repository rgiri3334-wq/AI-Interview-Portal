# AI Virtual Interview Platform — Environment Variables
# Copy this file to .env and fill in your actual values. NEVER commit .env.

# ── AI / Voice provider keys ──
# Gemini: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: separate Gemini key for the chatbot assistant (uses its own quota).
# If not set, the chatbot falls back to GEMINI_API_KEY.
GEMINI_CHATBOT_KEY=
GROQ_API_KEY=your_groq_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Database (Supabase / Postgres) ──
# Use postgresql:// ; URL-encode special chars in the password (e.g. @ -> %40)
DATABASE_URL=postgresql://user:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_key_here

# ── Email (SMTP) ──
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password

# ── Application secrets ──
# Strong random value, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`.
# If unset the app boots with an ephemeral secret and all sessions reset on restart.
JWT_SECRET=your_long_random_secret_here
# Seed password for the master admin account (change after first login).
# If unset, a random one is generated and logged once at startup.
MASTER_ADMIN_PASSWORD=set_a_strong_password_here

# ── Security / behavior config ──
# Comma-separated allowed browser origins for CORS. NEVER use "*".
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# Minimum fuzzy name-match score (0-100) required to pass KYC verification.
KYC_MATCH_THRESHOLD=60
# Seconds before abandoned chunked-upload temp files are swept (default 21600 = 6h).
TEMP_RECORDING_TTL_SECONDS=21600

# ── Branding / URLs ──
LOGO_URL=https://your-cdn.example.com/sterling_logo.png
BACKEND_URL=https://your-backend.example.com
FRONTEND_URL=https://your-frontend.example.com

# ── Server Config ──
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
