{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* This is a JS/JSX project — allow JS files so tsconfig has inputs,
       but don't deep type-check them (avoids flooding the Problems panel). */
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,

    /* Linting (relaxed for JS/JSX) */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
